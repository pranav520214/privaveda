# Compose works without copying this file: random DB and demo passwords are provisioned.
# To expose a Docker installation through a configured HTTPS reverse proxy:
BIND_ADDRESS=127.0.0.1
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Backend local settings (copy relevant values to backend/.env or set environment):
DATABASE_URL=sqlite:///./demo.db
# Optional bootstrap password for new demo users; at least 16 characters.
# Leave unset to generate separate random passwords in backend/demo-credentials.txt.
DEMO_PASSWORD=
EVIDENCE_THRESHOLD=0.65
EVIDENCE_MAX_AGE_DAYS=365
USE_HF_MODEL=false
HF_MODEL_ID=
HF_TOKEN=
HF_DEVICE=cpu

# Local Next.js proxy target. Docker bakes http://backend:8000 into its build.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
